{
    "name": "slothsoft/final-fantasy",
    "description": "A Farah module for Final Fantasy game data and save editing.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-xsl": "*",
        "slothsoft/core": "^1.15.1",
        "slothsoft/farah": "^1.29.7",
        "slothsoft/savegame": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.4",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.14",
        "symfony/polyfill-php83": "^1.31"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\FinalFantasy\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\FinalFantasy\\": "tests"
        }
    },
    "keywords": [
        "slothsoft",
        "farah-module",
        "final-fantasy",
        "savegame"
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "archive": {
        "exclude": [
            "*.nes",
            "*.sav",
            "*.srm",
            "/config.local.php",
            "/.ddev",
            "/.data",
            "/.cache",
            "/.log"
        ]
    }
}
