<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:sf1="http://schema.slothsoft.net/final-fantasy/i" xmlns:ssv="http://schema.slothsoft.net/schema/versioning" targetNamespace="http://schema.slothsoft.net/final-fantasy/i" elementFormDefault="qualified">
    <xs:annotation>
        <xs:appinfo>
            <ssv:info version="1.0">
                <ssv:name>Final Fantasy I Game Data</ssv:name>
                <ssv:version>1.0</ssv:version>
                <ssv:revision>R20261107</ssv:revision>
                <ssv:prefix>sf1</ssv:prefix>
                <ssv:namespace>http://schema.slothsoft.net/final-fantasy/i</ssv:namespace>
                <ssv:author email="daniel.lio.schulz@gmail.com">Daniel Schulz</ssv:author>
                <ssv:description><![CDATA[
This namespace describes game data extracted from the original US NES release of Final Fantasy I: classes, weapons, armor, spells, class permissions, and equipment save-editor state.
                ]]></ssv:description>
                <ssv:changelog><![CDATA[
*** Version 1.0 ***
    R20261107
        - initial schema for ROM-derived reference data and equipment save editing
        - optional mixed-content item labels preserve ROM glyph IDs for inline icons
                ]]></ssv:changelog>
            </ssv:info>
        </xs:appinfo>
    </xs:annotation>

    <xs:simpleType name="classId">
        <xs:restriction base="xs:unsignedByte">
            <xs:maxInclusive value="11" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="equipmentId">
        <xs:restriction base="xs:unsignedByte">
            <xs:minInclusive value="1" />
            <xs:maxInclusive value="40" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="spellReference">
        <xs:restriction base="xs:unsignedByte">
            <xs:maxInclusive value="64" />
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="classReference">
        <xs:attribute name="id" type="sf1:classId" use="required" />
    </xs:complexType>
    <xs:attributeGroup name="identity">
        <xs:attribute name="name" type="xs:string" use="required" />
        <xs:attribute name="price" type="xs:unsignedShort" use="required" />
    </xs:attributeGroup>
    <xs:complexType name="itemLabel" mixed="true">
        <xs:sequence>
            <xs:element name="icon" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:attribute name="glyph" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:unsignedByte">
                                <xs:minInclusive value="212" />
                                <xs:maxInclusive value="225" />
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="label" type="xs:string" use="required" />
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="weapon">
        <xs:sequence>
            <xs:element name="label" type="sf1:itemLabel" minOccurs="0" />
            <xs:element name="class-ref" type="sf1:classReference" minOccurs="0" maxOccurs="12" />
        </xs:sequence>
        <xs:attributeGroup ref="sf1:identity" />
        <xs:attribute name="id" type="sf1:equipmentId" use="required" />
        <xs:attribute name="hit" type="xs:unsignedByte" use="required" />
        <xs:attribute name="damage" type="xs:unsignedByte" use="required" />
        <xs:attribute name="critical" type="xs:unsignedByte" use="required" />
        <xs:attribute name="spell" type="sf1:spellReference" use="required" />
    </xs:complexType>
    <xs:complexType name="armor">
        <xs:sequence>
            <xs:element name="label" type="sf1:itemLabel" minOccurs="0" />
            <xs:element name="class-ref" type="sf1:classReference" minOccurs="0" maxOccurs="12" />
        </xs:sequence>
        <xs:attributeGroup ref="sf1:identity" />
        <xs:attribute name="id" type="sf1:equipmentId" use="required" />
        <xs:attribute name="evade-penalty" type="xs:unsignedByte" use="required" />
        <xs:attribute name="absorb" type="xs:unsignedByte" use="required" />
        <xs:attribute name="resistance-mask" type="xs:unsignedByte" use="required" />
        <xs:attribute name="spell" type="sf1:spellReference" use="required" />
        <xs:attribute name="category" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:unsignedByte">
                    <xs:maxInclusive value="3" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="spell">
        <xs:sequence>
            <xs:element name="class-ref" type="sf1:classReference" minOccurs="0" maxOccurs="12" />
        </xs:sequence>
        <xs:attributeGroup ref="sf1:identity" />
        <xs:attribute name="id" type="sf1:spellReference" use="required" />
        <xs:attribute name="level" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:unsignedByte">
                    <xs:minInclusive value="1" />
                    <xs:maxInclusive value="8" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="school" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="white" />
                    <xs:enumeration value="black" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="hit" type="xs:unsignedByte" use="required" />
        <xs:attribute name="effectivity" type="xs:unsignedByte" use="required" />
        <xs:attribute name="element-mask" type="xs:unsignedByte" use="required" />
        <xs:attribute name="target" type="xs:unsignedByte" use="required" />
        <xs:attribute name="effect" type="xs:unsignedByte" use="required" />
    </xs:complexType>
    <xs:simpleType name="slotIndex">
        <xs:restriction base="xs:unsignedByte">
            <xs:maxInclusive value="3" />
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="equipmentSlots">
        <xs:sequence>
            <xs:element name="slot" minOccurs="4" maxOccurs="4">
                <xs:complexType>
                    <xs:attribute name="index" type="sf1:slotIndex" use="required" />
                    <xs:attribute name="id" use="required">
                        <xs:simpleType>
                            <xs:restriction base="xs:unsignedByte">
                                <xs:maxInclusive value="127" />
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="equipped" type="xs:boolean" use="required" />
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="editor">
        <xs:sequence>
            <xs:element name="character" minOccurs="4" maxOccurs="4">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="weapons" type="sf1:equipmentSlots" />
                        <xs:element name="armor" type="sf1:equipmentSlots" />
                    </xs:sequence>
                    <xs:attribute name="index" type="sf1:slotIndex" use="required" />
                    <xs:attribute name="name" type="xs:string" use="required" />
                    <xs:attribute name="class" type="xs:unsignedByte" use="required" />
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="source" use="required">
            <xs:simpleType>
                <xs:restriction base="xs:base64Binary">
                    <xs:length value="8192" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>
    <xs:element name="final-fantasy">
        <xs:complexType>
            <xs:choice>
                <xs:sequence>
                    <xs:element name="classes">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="class" minOccurs="12" maxOccurs="12">
                                    <xs:complexType>
                                        <xs:attribute name="id" type="sf1:classId" use="required" />
                                        <xs:attribute name="name" type="xs:string" use="required" />
                                    </xs:complexType>
                                </xs:element>
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="weapons">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="weapon" type="sf1:weapon" minOccurs="40" maxOccurs="40" />
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="armor">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="item" type="sf1:armor" minOccurs="40" maxOccurs="40" />
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="spells">
                        <xs:complexType>
                            <xs:sequence>
                                <xs:element name="spell" type="sf1:spell" minOccurs="64" maxOccurs="64" />
                            </xs:sequence>
                        </xs:complexType>
                    </xs:element>
                    <xs:element name="error" type="xs:string" minOccurs="0" />
                    <xs:element name="editor" type="sf1:editor" minOccurs="0" />
                    <xs:element name="unavailable" type="xs:string" minOccurs="0" />
                </xs:sequence>
                <xs:element name="unavailable" type="xs:string" />
            </xs:choice>
            <xs:attribute name="version" type="xs:string" fixed="1.0" />
            <xs:attribute name="region" type="xs:string" fixed="US" />
            <xs:attribute name="rom-sha256" type="xs:string" />
            <xs:attribute name="view" type="xs:string" />
        </xs:complexType>
        <xs:key name="classId">
            <xs:selector xpath="sf1:classes/sf1:class" />
            <xs:field xpath="@id" />
        </xs:key>
        <xs:keyref name="weaponClass" refer="sf1:classId">
            <xs:selector xpath="sf1:weapons/sf1:weapon/sf1:class-ref" />
            <xs:field xpath="@id" />
        </xs:keyref>
        <xs:keyref name="armorClass" refer="sf1:classId">
            <xs:selector xpath="sf1:armor/sf1:item/sf1:class-ref" />
            <xs:field xpath="@id" />
        </xs:keyref>
        <xs:keyref name="spellClass" refer="sf1:classId">
            <xs:selector xpath="sf1:spells/sf1:spell/sf1:class-ref" />
            <xs:field xpath="@id" />
        </xs:keyref>
    </xs:element>
</xs:schema>
