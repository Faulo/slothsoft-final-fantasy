<?xml version="1.0" encoding="UTF-8"?>
<savegame xmlns="http://schema.slothsoft.net/savegame/editor" version="0.4">
    <!-- Offsets are PRG-relative. The NES extractor validates the US release and removes its container header. -->
    <!-- Layout: https://github.com/Entroper/FF1Disassembly/tree/master/Final%20Fantasy%20Disassembly -->
    <archive path="game.nes" type="NES">
        <file file-name="1">
            <binary name="initial-state" position="0x3000" size="256" />
            <binary name="initial-flags" position="0x2F00" size="256" />
            <binary name="starting-stats" position="0x3040" size="96" />
            <binary name="starting-party" position="0x3A0AE" size="64" />
            <!-- Full menu font: bank 09:$8800, PPU tiles 80–FF. -->
            <image name="menu-font" position="0x24800" size="2048" width="128" height="64" bitplanes="2" />
            <!-- Equipment subset: bank 09:$8D40, PPU tiles D4–E1. -->
            <image name="item-icons" position="0x24D40" size="224" width="112" height="8" bitplanes="2" />
            <binary name="menu-palette" position="0x3AD7C" size="4" />
            <!-- Bank 09:$AF00: cursor tiles F0-F3, arranged 2x2 by DrawCursor using sprite palette 3. -->
            <image name="menu-cursor" position="0x26F00" size="64" width="16" height="16" bitplanes="2" />
            <!-- Bank 09: 32 NES 2bpp tiles per class. Pose rows and sprite palettes are ROM data too. -->
            <repeat-group name="class-graphics" position="0x25000" group-count="12" group-size="0x200">
                <image name="tiles" size="512" width="16" height="128" bitplanes="2" />
            </repeat-group>
            <binary name="class-poses" position="0x3200C" size="32" />
            <binary name="sprite-palettes" position="0x3EBA5" size="16" />
            <binary name="class-palettes" position="0x3ECA4" size="12" />
            <repeat-group name="weapons" position="0x30000" group-count="40" group-size="8">
                <integer name="hit" position="0" size="1" />
                <integer name="damage" position="1" size="1" />
                <integer name="stored-critical" position="2" size="1" />
                <integer name="spell" position="3" size="1" />
                <integer name="unused-element" position="4" size="1" />
                <integer name="unused-category" position="5" size="1" />
            </repeat-group>
            <repeat-group name="armor" position="0x30140" group-count="40" group-size="4">
                <integer name="evade-penalty" position="0" size="1" />
                <integer name="absorb" position="1" size="1" />
                <integer name="resistance-mask" position="2" size="1" />
                <integer name="spell" position="3" size="1" />
            </repeat-group>
            <repeat-group name="spells" position="0x301E0" group-count="64" group-size="8">
                <integer name="hit" position="0" size="1" />
                <integer name="effectivity" position="1" size="1" />
                <integer name="element-mask" position="2" size="1" />
                <integer name="target" position="3" size="1" />
                <integer name="effect" position="4" size="1" />
            </repeat-group>
            <!-- Immediate operands in the US spell routines, not replacement balance values. -->
            <integer name="magic-base-hit-low" position="0x33874" size="1" />
            <integer name="magic-base-hit-high" position="0x33879" size="1" />
            <integer name="magic-roll-max" position="0x33A86" size="1" />
            <integer name="magic-weakness-hit" position="0x3386F" size="1" />
            <integer name="magic-hp-limit-low" position="0x33AE0" size="1" />
            <integer name="magic-hp-limit-high" position="0x33AE5" size="1" />
            <integer name="life-hp" position="0x3B02F" size="1" />
            <!-- Menu healing uses frame-counter masks and separate base values. -->
            <repeat-group name="menu-cure" position="0x3AF5F" group-count="3" group-size="8">
                <integer name="spread" position="0" size="1" />
                <integer name="minimum" position="2" size="1" />
            </repeat-group>
            <repeat-group name="menu-heal" position="0x3AFDF" group-count="3" group-size="9">
                <integer name="spread" position="0" size="1" />
                <integer name="minimum" position="3" size="1" />
            </repeat-group>
            <repeat-group name="prices" position="0x37C00" group-count="256" group-size="2">
                <integer name="price" size="2" byte-order="little" />
            </repeat-group>
            <repeat-group name="weapon-permissions" position="0x3BF50" group-count="40" group-size="2">
                <integer name="mask" size="2" byte-order="little" />
            </repeat-group>
            <repeat-group name="armor-permissions" position="0x3BFA0" group-count="40" group-size="2">
                <integer name="mask" size="2" byte-order="little" />
            </repeat-group>
            <repeat-group name="armor-categories" position="0x3BCD1" group-count="40" group-size="1">
                <integer name="category" size="1" />
            </repeat-group>
            <!-- Each pointer is local to its generated record; only the dereferencing node opts into scoped lookup. -->
            <repeat-group name="weapon-names" position="0x2B700 + 28 * 2" group-count="40" group-size="2">
                <integer name="pointer" size="2" byte-order="little" />
                <string name="text" position-from="root" position="$pointer + 0x20000" variable-resolution="scoped" type="null-delimited" encoding="ISO-8859-1" />
            </repeat-group>
            <repeat-group name="armor-names" position="0x2B700 + 68 * 2" group-count="40" group-size="2">
                <integer name="pointer" size="2" byte-order="little" />
                <string name="text" position-from="root" position="$pointer + 0x20000" variable-resolution="scoped" type="null-delimited" encoding="ISO-8859-1" />
            </repeat-group>
            <repeat-group name="spell-names" position="0x2B700 + 176 * 2" group-count="64" group-size="2">
                <integer name="pointer" size="2" byte-order="little" />
                <string name="text" position-from="root" position="$pointer + 0x20000" variable-resolution="scoped" type="null-delimited" encoding="ISO-8859-1" />
            </repeat-group>
            <repeat-group name="class-names" position="0x2B700 + 240 * 2" group-count="12" group-size="2">
                <integer name="pointer" size="2" byte-order="little" />
                <string name="text" position-from="root" position="$pointer + 0x20000" variable-resolution="scoped" type="null-delimited" encoding="ISO-8859-1" />
            </repeat-group>
            <repeat-group name="spell-permissions" position="0x3AD00" group-count="12" group-size="2">
                <integer name="pointer" size="2" byte-order="little" />
                <repeat-group name="levels" position-from="root" position="$pointer + 0x30000" variable-resolution="scoped" group-count="8" group-size="1">
                    <integer name="mask" size="1" />
                </repeat-group>
            </repeat-group>
        </file>
    </archive>
</savegame>
