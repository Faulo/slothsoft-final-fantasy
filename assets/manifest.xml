<?xml version="1.0"?>
<assets xmlns="http://schema.slothsoft.net/farah/module" version="1.1">
    <directory name="schema">
        <directory name="i">
            <resource name="1.0" path="1.0.xsd" type="application/xml" />
        </directory>
    </directory>
    <directory name="i">
        <resource-directory name="xsl" type="application/xslt+xml" />
        <resource-directory name="css" type="text/css" />
        <resource-directory name="savegame" type="application/xml" />
        <custom-asset name="font" executable-builder="Slothsoft\FinalFantasy\I\MenuFontBuilder" />
        <directory name="gfx">
            <custom-asset name="items" executable-builder="Slothsoft\FinalFantasy\I\ItemIconBuilder" />
            <custom-asset name="class" executable-builder="Slothsoft\FinalFantasy\I\ClassSpriteBuilder" parameter-filter="Slothsoft\FinalFantasy\I\ClassSpriteParameters" />
        </directory>
        <directory name="api">
            <custom-asset name="data" executable-builder="Slothsoft\FinalFantasy\I\PageDataBuilder" parameter-filter="Slothsoft\FinalFantasy\I\PageParameters" />
        </directory>
        <directory name="examples">
            <resource name="panels" path="panels.xhtml" type="application/xhtml+xml" />
        </directory>
    </directory>
</assets>
